<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
  <addon id="plugin.video.cinetelona" name="[COLOR FF00E5FF]CINE[/COLOR] [COLOR FFB565FF]TELONA[/COLOR]" version="1.6.1" provider-name="Nogueira">
    <requires>
      <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_br">Cine Telona - Filmes e Series</summary>
      <description lang="pt_br">Catalogo moderno de filmes e series.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>

  <addon id="repository.telona" name="[COLOR FF00E5FF]Repositorio[/COLOR] [COLOR FFB565FF]Telona[/COLOR]" version="1.0.2" provider-name="Nogueira">
    <extension point="xbmc.addon.repository" name="Repositorio Telona">
      <dir>
        <info compressed="false">https://github.io</info>
        <checksum>https://github.io.md5</checksum>
        <datadir zip="true">https://github.io</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="pt_br">Repositorio Oficial Cine Telona</summary>
      <description lang="pt_br">Atualizacoes automaticas do Cine Telona.</description>
      <platform>all</platform>
      <assets>
        <icon>icon.png</icon>
        <fanart>fanart.jpg</fanart>
      </assets>
    </extension>
  </addon>

  <addon id="repository.elementumorg" name="Elementumorg Repository" version="0.0.9" provider-name="elgatito">
    <extension point="xbmc.addon.repository" name="Elementumorg Repository">
      <dir>
        <info compressed="false">https://elementum.org</info>
        <checksum>https://elementum.org.md5</checksum>
        <datadir zip="true">https://elementum.org</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en">Elementumorg Repository</summary>
      <description lang="en">Repositorio oficial para instalar o Elementum em qualquer aparelho.</description>
      <platform>all</platform>
    </extension>
  </addon>
</addons>
